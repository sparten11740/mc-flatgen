{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.flatgen.platform.fabric.FabricClientEntrypoint"]
  },
  "mixins": ["${mod_id}-fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}"
  }
}
